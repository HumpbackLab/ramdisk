#!/bin/sh
${CVI_SHOPTS}

case "$1" in
  start)
    # dwc2.ko imports symbols exported by roles.ko when USB_ROLE_SWITCH=m.
    if [ -f /mnt/system/ko/roles.ko ] && [ ! -d /sys/module/roles ]; then
      insmod /mnt/system/ko/roles.ko || exit 1
    fi
    insmod /mnt/system/ko/dwc2.ko || exit 1
    echo device > /proc/cviusb/otg_role
    printf "Starting rndis: "
    /etc/run_usb.sh probe rndis
    /etc/run_usb.sh start
    ifconfig usb0 up
    ifconfig usb0 169.254.250.73
    [ $? = 0 ] && echo "OK" || echo "FAIL"
  ;;
  stop)
    printf "Stopping rndis: "
    /etc/run_usb.sh stop
    echo "OK"
    sleep 1
  ;;
  restart)
    printf "Restarting rndis: "
    /etc/run_usb.sh stop
    sleep 1
    /etc/run_usb.sh start
    echo "OK"
  ;;
esac
